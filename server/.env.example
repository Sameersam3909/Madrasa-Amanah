PORT=4000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────────────────
# Copy your Atlas connection string from Atlas → Connect → Drivers
MONGODB_URI=
MONGODB_URI_PRIMARY=
MONGODB_URI_SECONDARY=

# Storage thresholds (% of PRIMARY_STORAGE_LIMIT_MB before alert)
DATABASE_STORAGE_WARNING_PERCENT=70
DATABASE_STORAGE_CRITICAL_PERCENT=85
DATABASE_ROTATION_ENABLED=false
PRIMARY_STORAGE_LIMIT_MB=512

# ── Authentication ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-48-chars

CLIENT_ORIGIN=http://localhost:5173

# Bootstrap admin (used only if no users exist in the database)
ADMIN_NAME=Madrasa Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-long-password

# ── Cloudinary (optional — for student photos) ───────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / Weekly Reports (Nodemailer / Gmail SMTP) ─────────────
# Default recipient(s) for all scheduled and manual weekly reports (comma-separated).
# Administrators can override this in Settings → Weekly Report Recipient Email.
REPORT_RECIPIENT_EMAILS=2300030621cseh1@gmail.com, mdrafiq12118@gmail.com
REPORT_RECIPIENT_EMAIL=2300030621cseh1@gmail.com, mdrafiq12118@gmail.com
REPORT_TIMEZONE=Asia/Kolkata

# SMTP provider settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER: your Gmail address (e.g. yourname@gmail.com)
SMTP_USER=
# SMTP_PASS: Gmail App Password — NOT your account password
# Generate at: https://myaccount.google.com/apppasswords
# Requirements: Gmail account must have 2-Step Verification enabled
SMTP_PASS=

# ── Automated Monthly Backup ─────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BACKUP_SERVICE_TOKEN=generate-a-secure-random-token-at-least-16-chars

